{
  "name": "index",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "predev": "npm run data",
    "dev": "next dev",
    "prebuild": "npm run data && npm run validate",
    "build": "next build",
    "postbuild": "node scripts/check-export.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run lint && npm test && npm run check:release && npm run build",
    "data": "node scripts/webp-dims.mjs && node scripts/build-data.mjs"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7"
  },
  "overrides": { "postcss": "^8.5.28", "sharp": "^0.35.4" }
}
