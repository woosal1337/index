{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/categories/studios-portfolios",
      "destination": "/studios/",
      "permanent": true
    },
    {
      "source": "/categories/studios-portfolios/",
      "destination": "/studios/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/og/:path*",
      "destination": "https://index-media.chele.bi/og/:path*"
    },
    {
      "source": "/shots/:path*",
      "destination": "https://index-media.chele.bi/shots/:path*"
    },
    {
      "source": "/tpl/:path*",
      "destination": "https://index-media.chele.bi/tpl/:path*"
    }
  ],
  "headers": [
    {
      "source": "/og/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/shots/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    },
    {
      "source": "/tpl/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    }
  ]
}
